# === DistribucionAbogadosTPPG Environment Variables ===
# Copy this file to .env.local and set real values before production deployment.

# === Backend Security ===
# JWT secret for signing authentication tokens.
# Generate with: openssl rand -base64 32
# REQUIRED for production
JWT_SECRET=your-strong-random-secret-here-at-least-32-chars

# === Frontend Configuration ===
# Port for frontend server (default: 80 for HTTP, 443 for HTTPS)
PORT=80

# Frontend API endpoint (default: /api, which proxies through nginx)
VITE_API_URL=/api

# === Database Configuration ===
# SQLite for dev/test (not recommended for production)
# For production, use PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///app/data/database.sqlite

# === Runtime Environment ===
# Set to 'production' for production deployment
NODE_ENV=production

# === CORS Configuration ===
# Frontend URL for CORS (must match your production domain)
FRONTEND_URL=http://localhost

# === Admin Tools Security (IMPORTANT) ===
# Comma-separated list of trusted IP addresses allowed to access admin endpoints (/api/admin/*)
# Restrict to your office, VPN gateway, or internal admin network
# Examples:
#   10.0.0.5 (single IP)
#   10.0.0.5,10.0.0.6,192.168.1.10 (multiple IPs)
ADMIN_ALLOWED_IPS=

# === Production Recommendations ===
# 1. Always use HTTPS with valid TLS certificate (Let's Encrypt)
# 2. Set ADMIN_ALLOWED_IPS to restrict admin panel to trusted networks
# 3. Use a managed database service (RDS, PostgreSQL) instead of SQLite
# 4. Enable WAF rules in your load balancer
# 5. Use VPN for admin access
# 6. Enable audit logging and centralized log collection
# 7. Regularly rotate JWT_SECRET and database credentials
# 8. Use secrets management (AWS Secrets Manager, Vault) not .env files in production
# 9. Keep base images updated (node, nginx, alpine)
# 10. Scan container images for vulnerabilities (Trivy, Snyk)
